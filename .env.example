# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend ---
ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/electricity_market
# No Postgres/Docker locally? Use a SQLite file instead (path relative to
# backend/, where scripts/dev_backend.ps1 starts uvicorn):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0

# See docs/DATA_SOURCES.md. TSETMC and IEE_NEW are VERIFIED against live
# responses. IEE_OLD is only confirmed reachable - its collector is still
# an unimplemented stub.
TSETMC_BASE_URL=https://cdn.tsetmc.com/api
# Note: this is webapi.iee.ir, not newsite.iee.ir - the frontend domain
# only serves the SPA shell, the real API is on a different host.
IEE_NEW_BASE_URL=https://webapi.iee.ir/api
IEE_OLD_BASE_URL=https://oldsite.iee.ir

# Seconds between polls during active/inactive market hours.
POLL_INTERVAL=5
POLL_INTERVAL_ACTIVE=5
POLL_INTERVAL_IDLE=60
# IEE's firewall throttles 5s polling with intermittent 403s.
IEE_MIN_POLL_INTERVAL=15
MARKET_ACTIVE_HOURS_START=9
MARKET_ACTIVE_HOURS_END=15

HTTP_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=300
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

CACHE_TTL_SECONDS=30
STALE_AFTER_SECONDS=90

CORS_ORIGINS=http://localhost:3000

# Optional - leave blank to disable Telegram alerting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market
